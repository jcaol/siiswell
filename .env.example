# Self-hosted (Docker / bun) settings. Copy to .env, fill in, never commit .env.
# For a first try on one machine only PUBLIC_URL (http://localhost:8787) and ADMIN_PASSWORD matter; the README's
# Quick start adds the rest step by step (HTTPS proxy, phone pushes).
# The Cloudflare Worker reads the same names from wrangler.toml [vars] and `wrangler secret put`.

# The origin users open, exactly (scheme + host, no path). Required.
PUBLIC_URL=https://dash.example.com

# Sign-in: builtin (the dashboard's own admin login, the default) or proxy (your authenticating reverse proxy).
AUTH_MODE=builtin
# builtin: the admin password. The simple way: put it here (12+ characters; a long random one is best, e.g.
# `openssl rand -base64 24`). It is hashed (argon2id) when the server starts and never stored as text. Single-quote it
# (inside single quotes a `$` needs no escaping). Keep this file private (chmod 600). To change it: edit, then restart.
ADMIN_PASSWORD=''
# Or, instead, an argon2id hash of it (bun scripts/hash-password.ts reads the password from stdin). If both are set,
# the hash wins.
# ADMIN_PASSWORD_HASH=''
# The address(es) your TLS proxy connects from. With a proxy on the same machine (Caddy, nginx) and docker-compose.yml
# as shipped: 172.28.0.1/32. Leave empty while you open http://localhost:8787 directly.
TRUSTED_PROXY_CIDRS=
# proxy mode only:
# AUTH_PROXY_HEADER=X-Forwarded-Email
# ALLOWED_EMAILS=you@example.com

# Optional phone pushes (bun scripts/vapid.ts prints a key pair).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional.
# DASHBOARD_TZ=UTC            # IANA zone of the usage page's days and the well-being defaults
# RETENTION_DAYS=30
# USAGE_RETENTION_DAYS=800
# OTLP_INGEST=0               # 1 = accept OTLP/HTTP JSON metrics (docs/otel.md)
# WELLBEING_PUSH_POLICY=1     # 0 = one push per alert, no digest / quiet hours
