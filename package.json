{
  "name": "siiswell-server",
  "license": "(AGPL-3.0-only AND Apache-2.0)",
  "version": "0.6.0",
  "private": true,
  "description": "siiswell: what your AI coding agents are working on and what they cost (Cloudflare Worker + D1 + static PWA, or Docker)",
  "homepage": "https://siiswell.com",
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false wrangler dev --local",
    "deploy": "bun scripts/deploy.ts",
    "migrate:local": "WRANGLER_SEND_METRICS=false wrangler d1 migrations apply siiswell --local",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.cli.json",
    "build:cli": "bun cli/build.ts",
    "test": "bun test",
    "token": "bun scripts/new-token.ts",
    "vapid": "bun scripts/vapid.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/bun": "1.3.6",
    "typescript": "6.0.3",
    "wrangler": "4.142.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "mcp",
    "mcp-server",
    "llm",
    "llm-usage",
    "token-usage",
    "ai-cost",
    "developer-tools",
    "self-hosted",
    "dashboard",
    "well-being",
    "notifications"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcaol/siiswell.git"
  },
  "bugs": {
    "url": "https://github.com/jcaol/siiswell/issues"
  },
  "author": "siiswell.com <hello@siiswell.com> (https://siiswell.com)"
}
